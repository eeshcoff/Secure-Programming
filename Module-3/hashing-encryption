        if choice == "1":
            cipher()
        elif choice == "2":
            hashing()
        elif choice == "3":
            signing()
        elif choice == "4":
            verify_signature()
        elif choice == "5":
            print("Exiting.")
            break
        else:
            print("Invalid choice. Please try again.")

if __name__ == "__main__":
    main()